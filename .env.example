# All optional. The app runs with none of these set.

# Identifies this app to the National Weather Service API (they ask for contact details).
# Example: "my-weather-monitor (ops@example.com)"
NWS_USER_AGENT=

# Protects /api/cron/weather-monitors. Required in production if an external cron calls it.
CRON_SECRET=

# Email delivery for saved monitors, through Resend (https://resend.com). Without a key no email is sent.
RESEND_API_KEY=
# Sender address. The domain must be verified in Resend. The default "onboarding@resend.dev" only
# delivers to the email address of the Resend account itself, which is enough to try it out.
EMAIL_FROM="Weather Monitor <onboarding@resend.dev>"
# IANA time zone used for times inside emails (default America/New_York).
EMAIL_TIME_ZONE=

# Set to "off" to disable the in-process scheduler (e.g. on serverless hosting with an external cron).
WEATHER_SCHEDULER=

# Where saved monitors and lookup caches are stored (defaults: ./data and ./.cache/weather).
WEATHER_DATA_DIR=
WEATHER_CACHE_DIR=

# Map basemap style (any MapLibre style URL). Public, not a secret.
NEXT_PUBLIC_MAP_STYLE_URL=
